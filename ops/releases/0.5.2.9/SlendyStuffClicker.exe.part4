            var lumpReady=o.lumpRule==='ripe'?ripe:mature,threshold=o.lumpRule==='ripe'?num(G.lumpRipeAge):num(G.lumpMatureAge);
            add('lump:harvest','Harvest sugar lump ('+o.lumpRule+')',0,stamp([G.lumps,G.lumpT,G.lumpRipeAge,G.lumpMatureAge,G.canLumps(),o.lumpRule]),function(){var before=G.lumpT;G.clickLump();if(G.lumpT!==before)counters.lumps++;},!maturityKnown?'Native lump maturity is unavailable':!lumpReady?'Waiting for native '+o.lumpRule+' maturity':!Number.isFinite(G.lumpOverripeAge)||age>=G.lumpOverripeAge?'Waiting for native overripe handling':'');
        }
