        var maturityKnown=can&&Number.isFinite(G.lumpT)&&Number.isFinite(G.lumpRipeAge)&&G.lumpRipeAge>0&&Number.isFinite(G.lumpMatureAge)&&G.lumpMatureAge>0;
        var ripe=maturityKnown&&age>=G.lumpRipeAge,mature=maturityKnown&&age>=G.lumpMatureAge;
