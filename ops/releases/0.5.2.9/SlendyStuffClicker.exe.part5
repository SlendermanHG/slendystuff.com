    function execute(request,o,b,now){if(!request||request.id===handled)return false;handled=request.id;var q=quotes.get(request.key);
        if(comboBusy(o)){log('Action cancelled: pause combo assistance before other game actions');return false;}
        if(!q||q.id!==request.quote||q.reason||now-q.created>30000){log('Action cancelled: preview expired or game state changed');return false;}
        // Rebuild the quote and compare the live preconditions before any spending or sacrifice.
        var previous=q;quoteView(o,b);q=quotes.get(request.key);if(!q||q.fingerprint!==previous.fingerprint||q.cost!==previous.cost||q.reason){log('Action cancelled: resources or requirements changed');return false;}
        if(o.completionist&&policy(o).target&&/^(ascend|sell:|dragon:|santa:|aura:|special:|level:|lump:|garden:|pantheon:|stock:|spell:|seasonbuy:)/.test(request.key)&&!advancedGoalAllows(o,request.key)){log('Stop Completionist before a conflicting destructive action');return false;}
        q.run();log('Approved action: '+q.label);return true;
    }
    function advancedGoalAllows(o,key){
        var protection=policy(o);if(protection.hold)return false;if(!protection.target)return true;
        var name=protection.target;
        return key==='lump:harvest'&&['Dude, sweet','Sugar rush',"Year's worth of cavities"].includes(name)||key.indexOf('spell:cast:')===0&&['Bibbidi-bobbidi-boo',"I'm the wiz",'A wizard is you'].includes(name)||key.indexOf('garden:harvest:')===0&&['Botany enthusiast','Green, aching thumb'].includes(name)||key.indexOf('stock:')===0&&['Liquid assets','Gaseous assets'].includes(name)||key.indexOf('santa:')===0&&['Coming to town','All hail Santa'].includes(name);
    }
    function automaticAdvanced(o,b,now){
        if(pending||policy(o).hold||comboBusy(o))return false;
        var offered=quoteView(o,b).filter(function(q){return q.available&&advancedGoalAllows(o,q.key);}),chosen=null;
        if(o.lumpHarvest)chosen=offered.find(function(q){return q.key==='lump:harvest'&&q.available;})||null;
        if(!chosen&&o.gardenHarvest)chosen=offered.find(function(q){return q.key.indexOf('garden:harvest:')===0&&q.available;})||null;
        if(!chosen&&o.petFocus)chosen=offered.find(function(q){return q.key==='dragon:egg'&&q.available;})||offered.find(function(q){return q.key==='dragon:train'&&q.available;})||null;
        if(!chosen&&o.santaFocus)chosen=offered.find(function(q){return q.key==='santa:hat'&&q.available;})||offered.find(function(q){return q.key==='santa:level'&&q.available;})||null;
        if(!chosen&&o.seasonBuy)chosen=offered.find(function(q){return q.key.indexOf('seasonbuy:')===0&&q.available;})||null;
        if(!chosen&&o.spells&&!o.combo)chosen=offered.find(function(q){return q.key.indexOf('spell:cast:')===0&&q.available;})||null;
        if(!chosen&&o.stock)chosen=offered.find(function(q){return q.key.indexOf('stock:')===0&&q.available;})||null;
        if(!chosen||!advancedGoalAllows(o,chosen.key))return false;
        return execute({id:'opt-in:'+chosen.id+':'+now,key:chosen.key,quote:chosen.id},o,b,now);
    }
    // Native identities, not pictures, remain authoritative across all seasonal skins.
    function petView(o){
        var level=Number.isInteger(G.dragonLevel)?G.dragonLevel:0,levels=G.dragonLevels||[],need=[],cookieCost=0;
        if(o.petFocus&&level<levels.length-1){
            if(level<=4)cookieCost=Math.pow(2,level)*1000000;
            else if(level<levels.length-3)need=[{id:level-5,amount:100}];
            else need=(G.ObjectsById||[]).slice(0,32).map(function(b){return {id:b.id,amount:level===levels.length-3?50:200};});
        }
        var missing=need.filter(function(n){var b=G.ObjectsById&&G.ObjectsById[n.id];return !b||num(b.amount)<n.amount;});
        var drops=['Dragon scale','Dragon claw','Dragon fang','Dragon teddy bear'],remaining=drops.filter(function(n){var u=G.Upgrades&&G.Upgrades[n];return u&&!u.unlocked&&!u.bought;});
        var status=!o.petFocus?'Dragon training focus is off':!has('A crumbly egg')?'Requires How to bake your dragon and A crumbly egg':!levels.length?'Dragon rules unavailable':level>=levels.length-1?'Dragon fully trained':need.length&&!o.petSacrifices?'Waiting for permission to sacrifice buildings':missing.length?'Needs '+missing.map(function(n){var b=G.ObjectsById&&G.ObjectsById[n.id];return (b?b.name:'Building '+n.id)+': '+n.amount;}).join(', '):'Next training step ready if its cost fits your reserve';
        return {level:level,need:need,missing:missing,cookieCost:cookieCost,remaining:remaining,summary:status+'\nDragon level '+level+' / '+Math.max(0,levels.length-1)+'\nPetting drops left: '+(remaining.join(', ')||'None listed')+'\nPetting requires the open dragon panel; chance and time windows stay native.\nSanta: '+num(G.santaLevel)+' / '+Math.max(0,(G.santaLevels||[]).length-1)+(G.season==='christmas'?' (Christmas active)':' (waiting for Christmas; no automatic season purchase)')};
    }
    function pets(o,b){
        if(G.promptOn||G.OnAscend||G.AscendTimer>0||policy(o).target||policy(o).hold)return false;
        var view=petView(o);
        if(o.dragonPet&&has('Pet the dragon')&&G.dragonLevel>=4&&G.specialTab==='dragon'&&typeof G.ClickSpecialPic==='function'&&view.remaining.length){G.ClickSpecialPic();return true;}
        return false;
    }
    var ascendPhase='watching',ascendError='',cycleOwned=false,saveSerial=0,lastFresh=-Infinity,lastAscendAction=-Infinity,liveCommand=null,planAt=-Infinity,chipPlan=null;
    function prestigeGain(){
        if(typeof G.HowMuchPrestige!=='function'||!Number.isFinite(G.cookiesReset)||!Number.isFinite(G.cookiesEarned)||!Number.isSafeInteger(G.prestige))return 0;
        var value=Math.floor(G.HowMuchPrestige(G.cookiesReset+G.cookiesEarned))-G.prestige;
        return Number.isSafeInteger(value)&&value>0?value:0;
    }
    function heavenlyPlan(budget){
        if(!Number.isSafeInteger(budget)||budget<0)return {items:[],spend:0,reason:'Chip balance needs manual review'};
        var all=G.PrestigeUpgrades;if(!Array.isArray(all)||all.length>256)return {items:[],spend:0,reason:'Heavenly catalog unavailable'};
        var entries=all.filter(function(u){return u&&u.pool==='prestige'&&!u.bought&&u.vanilla!==0&&!u.clickFunction&&!u.choicesFunction&&!u.activateFunction&&!u.canBuyFunc&&typeof u.buy==='function'&&typeof u.getPrice==='function';});
        var prices=new Map();entries=entries.filter(function(u){var price=u.getPrice();if(!Number.isSafeInteger(price)||price<0||price>budget)return false;if(u.showIf&&!u.showIf())return false;prices.set(u,price);return true;});
        // Each package includes unowned parents in dependency order. Bounded best-fit;
        // live visibility, price, parents and balance are checked again before buying.
        var best={items:[],spend:0},start=performance.now(),steps=0;
        function packageFor(u,owned,visiting){if(u.bought||owned.has(u))return [];if(!prices.has(u)||visiting.has(u))return null;visiting.add(u);var result=[],parents=u.parents||[];if(!Array.isArray(parents)||parents.length>32)return null;for(var p of parents){if(p===-1)continue;if(typeof p==='string')p=G.Upgrades&&G.Upgrades[p];if(!p)return null;var chain=packageFor(p,new Set([...owned,...result]),visiting);if(chain===null)return null;result.push(...chain);}visiting.delete(u);result.push(u);return result;}
        // Try every affordable initial package, then fill the remainder in best-fit
        // order. The deadline/candidate limit prevents a large tree freezing the game.
        for(var first=-1;first<entries.length&&steps<4096&&performance.now()-start<2;first++){
            var owned=new Set(),items=[],spent=0,firstChain=first<0?[]:packageFor(entries[first],owned,new Set());if(firstChain===null)continue;
            var initial=firstChain.reduce(function(n,u){return n+prices.get(u);},0);if(initial>budget)continue;firstChain.forEach(function(u){owned.add(u);items.push(u);});spent=initial;
            while(items.length<256&&performance.now()-start<2){var chosen=null,price=-1;for(var u of entries){if(++steps>4096)break;var chain=packageFor(u,owned,new Set());if(!chain||!chain.length)continue;var cost=chain.reduce(function(n,it){return n+prices.get(it);},0);if(cost<=budget-spent&&cost>price){chosen=chain;price=cost;}}if(!chosen||steps>4096)break;chosen.forEach(function(u){owned.add(u);items.push(u);});spent+=price;}
            if(spent>best.spend||spent===best.spend&&items.length>best.items.length)best={items:items,spend:spent};
        }
        best.reason='Bounded best-fit spending; choice upgrades are left for manual setup';return best;
    }
    function ascensionView(o,now){
        var gain=prestigeGain(),chips=num(G.heavenlyChips),budget=G.OnAscend?chips:chips+gain;
        if(now-planAt>=5000||!chipPlan){planAt=now;chipPlan=heavenlyPlan(budget);}
        var hold=!o.ascensionAssistant?'Assistant is off':ascendError||ascendPhase==='saving'?'Saving before ascension':!G.OnAscend&&gain<o.ascendMinimum?'Waiting for minimum new prestige':!chipPlan.items.length?'No new automatic heavenly purchases fit the budget':'New heavenly upgrades fit the chip budget';
        if(ascendError)hold=ascendError;
        return {gain:gain,phase:ascendPhase,spend:chipPlan.spend,items:chipPlan.items.slice(0,32).map(function(u){return text(u.name,100);}),summary:hold+'\nNew prestige: '+gain+' / '+o.ascendMinimum+' minimum\nChip budget: '+budget+' · Planned spending: '+chipPlan.spend+'\n'+chipPlan.items.slice(0,12).map(function(u){return text(u.name,100);}).join(', ')+'\n'+chipPlan.reason+'\n'+(cycleOwned?'This session owns the ascension cycle.':'Existing manual ascensions are not automatically completed.')};
    }
    function ascendTick(command,o,now,fresh){
        liveCommand=command;if(fresh)lastFresh=now;
        if(!command.running||!o.ascensionAssistant){saveSerial++;if(ascendPhase==='saving')ascendPhase='watching';return false;}
        if(!fresh||ascendError||G.promptOn||G.AscendTimer>0||G.ReincarnateTimer>0||policy(o).target||rankingPending&&o.completionist&&o.assist)return false;
        if(now-lastAscendAction<1000)return false;lastAscendAction=now;
        if(G.OnAscend){
            if(!cycleOwned)return false;
            if(o.heavenlyBuy){var plan=heavenlyPlan(num(G.heavenlyChips)),u=plan.items[0];if(u){var price=u.getPrice(),parents=u.parents||[];
                if(u.pool!=='prestige'||u.bought||u.canBePurchased!==1||u.showIf&&!u.showIf()||parents.some(function(p){if(p===-1)return false;if(typeof p==='string')p=G.Upgrades[p];return !p||!p.bought;})||price>num(G.heavenlyChips)||!Number.isSafeInteger(price)){ascendError='Heavenly purchase changed; review the tree manually';return false;}
                var before=u.bought;u.buy();if(u.bought<=before){ascendError='Heavenly purchase did not complete; review manually';return false;}planAt=-Infinity;log('Bought heavenly upgrade: '+u.name);return true;
            }}
            if(o.autoReincarnate&&G.nextAscensionMode===0&&typeof G.Reincarnate==='function'){G.Reincarnate(1);cycleOwned=false;ascendPhase='watching';planAt=-Infinity;log('Reincarnated after the approved ascension cycle');return true;}
            ascendPhase='awaiting reincarnation';return false;
        }
        if(ascendPhase==='saving'||!Number.isInteger(G.ascensionMode)||G.ascensionMode!==0||num(G.T)<3||activeBonus())return false;
        var gain=prestigeGain();if(gain<o.ascendMinimum)return false;
        var view=heavenlyPlan(num(G.heavenlyChips)+gain);
        if(!view.items.length||typeof verifySave!=='function'||typeof G.Ascend!=='function')return false;
        if(o.ascendPayouts){var stored=(G.wrinklers||[]).slice(0,32).filter(function(w){return w&&w.phase>0&&num(w.sucked)>0;});
            if(stored.length){var payout=stored.find(function(w){return w.type!==1&&w.phase===2&&w.hp>0.5&&fed.has(w)&&(now-fed.get(w))/1000>=o.feedSeconds;});
                if(payout){popWrinkler(payout);log('Collected a normal feeding wrinkler before ascension');return true;}return false;
            }
        }
        var serial=++saveSerial,epoch=G.resets;ascendPhase='saving';log('Verifying a local save before the approved ascension');
        Promise.resolve().then(function(){return verifySave();}).then(function(){
            if(serial!==saveSerial||!liveCommand||!liveCommand.running||!liveCommand.gameplay.ascensionAssistant||performance.now()-lastFresh>250||G.resets!==epoch||G.OnAscend||G.AscendTimer>0||G.promptOn||policy(liveCommand.gameplay).target)return;
            // Recompute viability after saving; no stale spending/reset approval.
            var gainNow=prestigeGain(),check=heavenlyPlan(num(G.heavenlyChips)+gainNow);
            if(gainNow<liveCommand.gameplay.ascendMinimum||!check.items.length||activeBonus()||liveCommand.gameplay.ascendPayouts&&(G.wrinklers||[]).some(function(w){return w&&w.phase>0&&num(w.sucked)>0;}))return;
            cycleOwned=true;ascendPhase='ascending';G.Ascend(1);log('Requested native ascension after verified save');
        }).catch(function(){if(serial===saveSerial){ascendError='Save verification failed; ascension stays stopped';log(ascendError);}}).finally(function(){if(serial===saveSerial&&ascendPhase==='saving')ascendPhase='watching';});return true;
    }
    function drawWrinklerCountdowns(){
        if(!liveCommand||!liveCommand.running||!liveCommand.gameplay.wrinklerOverlay||!liveCommand.gameplay.wrinklers||performance.now()-lastFresh>250||!supported||G.OnAscend)return;
        var ctx=G.LeftBackground;if(!ctx||typeof ctx.fillText!=='function')return;var o=liveCommand.gameplay,now=performance.now(),items=wrinklerView(o,now).items;
        ctx.save();try{ctx.font='bold 12px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.globalAlpha=0.95;
            items.forEach(function(item){var w=G.wrinklers[item.slot-1];if(!w||!Number.isFinite(w.x)||!Number.isFinite(w.y)||w.hp<=0.5)return;var label=item.type==='Shiny'?'Protected':item.phase!==2?'Feed '+item.waitSeconds+'s':item.waitSeconds>0?item.waitSeconds+'s':item.eligible?'Ready':item.reason.startsWith('Keeping')?'Kept':item.stored<o.storedMinimum?'Minimum':!item.stored?'Not feeding':'Waiting';
                var width=Math.min(130,ctx.measureText(label).width+12),x=w.x,y=w.y+30;ctx.fillStyle='#111a32';ctx.fillRect(x-width/2,y-10,width,20);ctx.fillStyle='#ff6eb5';ctx.fillText(label,x,y);
            });
        }finally{ctx.restore();}
    }

    function tick(command,o,now,fresh){
        if(command.releaseSeason&&command.releaseSeason!==released){released=command.releaseSeason;seasonLock='';log('Selected season released; no automatic switch was purchased');}
        if(session!==command.session){session=command.session;saveSerial++;ascendError='';cycleOwned=false;ascendPhase='watching';tradeSpent=Number.isFinite(command.stockCarry)&&command.stockCarry>=0&&command.stockCarry<=1e300?command.stockCarry:0;lastAction=-Infinity;handled='';fed.clear();comboAttempts=0;comboSales=Number.isInteger(command.comboCarry)&&command.comboCarry>=0&&command.comboCarry<=20?command.comboCarry:0;comboLastCast=-Infinity;comboWindows=new WeakSet();comboSaleWindows=new WeakSet();}
        if(!supported)return;
        prepare(o,now);observeWrinklers(now);ascendTick(command,o,now,fresh);
        var comboActed=comboTick(command,o,now,fresh);
        if(pending){if(now>=pendingUntil){pending=null;backfireUntil=now+60000;log('Spell result delayed; automatic casting held for one minute');}return;}
        var p=policy(o);
        if(command.running&&fresh&&!p.hold&&!G.promptOn&&!G.OnAscend&&G.T>=3){
            if(!comboActed&&!comboBusy(o)&&now-lastAction>=1000){lastAction=now;var acted=execute(command.action,o,command.autoBuy,now);
                if(!acted)acted=wrinklers(o,now);if(!acted)acted=pets(o,command.autoBuy);if(!acted)acted=automaticAdvanced(o,command.autoBuy,now);

            }
        }
