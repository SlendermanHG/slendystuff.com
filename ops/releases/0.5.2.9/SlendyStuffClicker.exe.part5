            snapshot={schema:1,version:text(G.version,20),supported:supported,season:text(G.season,20),resets:num(G.resets),cookies:num(G.cookies),production:num(G.cookiesPs),tradeSpent:tradeSpent,buffs:buffs(),seasons:seasons,goals:rows.slice(o.goalPage*256,(o.goalPage+1)*256),goalTotal:rows.length,goalSummary:rankingPending?'Reading the installed achievement catalog...':rows.length+' matching achievements; sorted by readiness, cost and progress. Choose Suggest only, select a goal, then Pin selected. Filters and search apply to the full catalog.',goalPage:o.goalPage,target:target,policy:policy(o),shop:shop(command.autoBuy,o,p.upgrades,false),wrinklers:wrinklerView(o,now),pets:petView(o),ascension:ascensionView(o,now),counters:Object.assign({},counters),history:history.slice(),actions:actions,
                tools:{garden:advancedState.garden,grimoire:advancedState.grimoire,pantheon:advancedState.pantheon,dragon:'Level '+num(G.dragonLevel)+'; petting needs the open dragon panel',stock:advancedState.stock,ascension:'Potential prestige '+num(G.ascendMeterLevel)+'; prepare: save, review wrinklers, rare harvests and Chocolate egg; select the native challenge mode after ascension',auraAdvice:'Production: Radiant Appetite / Breath of Milk; clicks: Dragonflight; wrinklers: Dragon Guts. Review your build before sacrificing.'},
                lumps:{available:num(G.lumps),status:!can?'Locked':!Number.isFinite(G.lumpT)||!Number.isFinite(G.lumpRipeAge)||!Number.isFinite(G.lumpMatureAge)?'Native maturity unavailable':Date.now()-G.lumpT>=G.lumpRipeAge?'Ripe':Date.now()-G.lumpT>=G.lumpMatureAge?'Mature (native harvest may fail)':'Growing',seconds:can&&Number.isFinite(G.lumpT)&&Number.isFinite(G.lumpRipeAge)?Math.max(0,Math.ceil((G.lumpT+G.lumpRipeAge-Date.now())/1000)):0,rule:o.lumpRule},
                advanced:advancedState,combo:comboView(),
                stocks:(mini(5)&&Array.isArray(mini(5).goodsById)&&typeof mini(5).getGoodPrice==='function'?mini(5).goodsById:[]).slice(0,32).map(function(g){var market=mini(5);return {name:text(g.name,60),price:num(g.val),stock:num(g.stock),cost:stockCost(market,g),advice:g.val<=o.stockBuy?'Below buy target':g.val>=o.stockSell?'Above sell target':'Watch'};}),seedGoals:advancedState.plants.filter(function(p){return !p.unlocked;}).map(function(p){return p.name;}),steam:'Game-earned flags only; Steam delivery is not independently confirmed'};
        }
    }
    return {comboSales:function(){return comboSales;},spent:function(){return tradeSpent;},draw:drawWrinklerCountdowns,petView:petView,heavenlyPlan:heavenlyPlan,ascensionView:ascensionView,validate:valid,prepare:prepare,policy:policy,tick:tick,shimmers:shimmers,shop:shop,inspect:function(){return supported?Object.assign({schema:1,version:text(G.version,20),supported:true},snapshot):{schema:1,version:text(G.version,20),supported:false,history:['Advanced actions stopped: installed game version needs adapter review']};},seasonView:seasonView,natural:natural,easter:easter,rule:rule,reserve:reserve,execute:execute,quotes:quoteView,counters:counters};
}

