            var live=G.seasons && G.seasons[w.id], u=live && live.triggerUpgrade;
            var next=w.end<today ? windows(date.getFullYear()+1).find(function(n){return n.id===w.id;}) : w;
            var days=Math.ceil((next.start-today)/86400000), active=G.season===w.id;
            var state=active?'Active':present.length && done===present.length?'Completed':has('Season switcher')&&u&&u.unlocked?'Available through Season Switcher':days>=0&&days<=o.noticeDays?'Upcoming':'Locked';
            var missing=present.filter(function(n){return !has(n);});
