            return {id:w.id,name:w.name,state:state,window:dateText(next.start)+' to '+dateText(next.end)+' (planning)',days:Math.max(0,days),notice:o.noticeDays>0&&days>=0&&days<=o.noticeDays&&!active,done:done,total:present.length,unlocked:unlocked,missing:missing.slice(0,36),spending:cost,switchPrice:u&&typeof u.getPrice==='function'?num(u.getPrice()):0,
                reason:!supported?'Installed game version needs review':w.id==='fools'?'Calendar event; no exclusive achievement required':w.id==='halloween'&&!num(G.elderWrath)?'Wrinkler access requires the Grandmapocalypse':w.id==='christmas'&&!has('A festive hat')?'Acquire a festive hat for Santa':missing.length?'Drops and purchases repeat after ascension':'Collection complete for this ascension',
                achievements:({halloween:['Spooky cookies'],christmas:['Let it snow','Coming to town','All hail Santa','Reindeer sleigher','Eldeer'],valentines:['Lovely cookies'],easter:['The hunt is on','Egging on','Mass Easteria','Hide & seek champion'],fools:[]}[w.id]).map(function(n){return n+': '+(won(n)?'earned permanently':'not yet earned');})};
