    function windows(y) { var end=easter(y),start=new Date(y,end.getMonth(),end.getDate()-7); return [
        { id:'valentines',name:"Valentine's Day",start:new Date(y,1,10),end:new Date(y,1,15) },
        { id:'fools',name:'Business Day',start:new Date(y,2,31),end:new Date(y,3,2) },
        { id:'easter',name:'Easter',start:start,end:end },
        { id:'halloween',name:'Halloween',start:new Date(y,9,24),end:new Date(y,9,31) },
        { id:'christmas',name:'Christmas',start:new Date(y,11,15),end:new Date(y,11,31) } ]; }
    function natural(date) { var day=new Date(date.getFullYear(),date.getMonth(),date.getDate()); return windows(date.getFullYear()).find(function (w) { return day >= w.start && day <= w.end; }); }
    function dateText(d) { return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
    function lists(id) {
