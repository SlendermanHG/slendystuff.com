        var collection={'Spooky cookies':['halloween',7],'Let it snow':['christmas',7],'Lovely cookies':['valentines',7],'The hunt is on':['easter',1],'Egging on':['easter',7],'Mass Easteria':['easter',14],'Hide & seek champion':['easter',20]};
