    function shop(options,o,allowUpgrades,execute) {
        var retained=reserve(o,options), available=num(G.cookies)-retained, best=null;
        if(!supported||G.buyMode!==1||G.promptOn||available<0||(o.protectBuffs&&activeBonus())) return {reason:'Reserve, active bonus, prompt or Sell mode protects spending',reserve:retained};
        function consider(item,building,priority){if(!item||typeof item.getPrice!=='function'||typeof item.buy!=='function')return;var price=item.getPrice(),gain=0,known=false;if(!Number.isFinite(price)||price<0||price>available)return;
            if(building){gain=num(item.storedCps)*num(G.globalCpsMult || 1);known=gain>0;}else if(item.pool==='cookie'&&typeof item.power==='number'){gain=num(G.cookiesPs)*item.power/100;known=gain>0;}else if(item.buildingTie&&item.tier!=null){gain=num(item.buildingTie.storedTotalCps)*num(G.globalCpsMult || 1);known=gain>0;}
            var score=o.shopMode==='cheapest'?price/priority:known?price/gain/priority:1e290+price;
            if(!best||score<best.score)best={item:item,building:building,price:price,gain:gain,known:known,score:score};}
        var selected=options.buildings.slice(),petNeeds=o.petFocus&&o.petSacrifices&&!policy(o).target?petView(o).missing:[];if(petNeeds.length)selected=selected.filter(function(id){return petNeeds.some(function(n){return n.id===id;});});
        if(o.completionist&&o.assist&&target&&target.building!=null&&target.state!=='Ineligible this run'&&selected.includes(target.building))selected=[target.building];
        selected.forEach(function(id){var b=G.ObjectsById&&G.ObjectsById[id],r=o.buildingRules.find(function(r){return r.id===id;});if(!b||b.locked)return;var ceiling=r&&r.target>0?r.target:r&&r.cap>0?r.cap:Infinity;if(r&&r.cap>0)ceiling=Math.min(ceiling,r.cap);if(target&&o.completionist&&o.assist&&target.building===id)ceiling=Math.min(ceiling,target.goal);var petNeed=petNeeds.find(function(n){return n.id===id;});if(petNeed){ceiling=Math.max(ceiling===Infinity?0:ceiling,petNeed.amount);if(r&&r.cap>0)ceiling=Math.min(ceiling,r.cap);}if(num(b.amount)<ceiling)consider(b,true,r?r.priority:1);});
        var store=G.UpgradesInStore,begin=performance.now();if(allowUpgrades&&Array.isArray(store)&&store.length<=2048)for(var i=0;i<store.length&&performance.now()-begin<2;i++){var u=store[i];if(!u||!u.unlocked||u.bought||!options.upgrades.includes(u.pool)||u.priceLumps>0||u.clickFunction||u.choicesFunction||u.canBuyFunc||u.vanilla===0||(u.isVaulted&&u.isVaulted())||['Chocolate egg','A crumbly egg','A festive hat'].includes(u.name))continue;consider(u,false,1);}
        if(!best)return {reason:'No selected purchase fits the reserve and targets',reserve:retained};
        var view={name:text(best.item.name,100),price:best.price,gain:best.gain,payoff:best.known?best.price/best.gain:null,reason:best.known?'Estimated production payoff; synergy may change it':'Production gain is unknown; lowest-price fallback',reserve:retained};
        if(execute){var it=best.item,p=it.getPrice();if(!Number.isFinite(p)||p<0||p>num(G.cookies)-reserve(o,options)||G.promptOn||G.buyMode!==1||G.OnAscend)return view;var before=best.building?it.amount:it.bought;if(best.building)it.buy(1);else it.buy();view.purchased=(best.building?it.amount:it.bought)>before;}
        return view;
    }
    function popWrinkler(w) { if(w&&w.phase>0&&Number.isFinite(w.hp)&&w.hp>0.5){w.hp=0;G.recalculateGains=1;counters.wrinklers++;log('Requested native wrinkler payout');return true;}return false; }
    function observeWrinklers(now){var keys=new Set();(Array.isArray(G.wrinklers)?G.wrinklers:[]).slice(0,32).forEach(function(w){if(!w||w.phase!==2||num(w.sucked)===0||!Number.isFinite(w.hp)||w.hp<=0.5){fed.delete(w);return;}keys.add(w);if(!fed.has(w))fed.set(w,now);});fed.forEach(function(v,w){if(!keys.has(w))fed.delete(w);});}
    function wrinklerView(o,now){var all=(Array.isArray(G.wrinklers)?G.wrinklers:[]).slice(0,32),alive=all.filter(function(w){return w&&w.phase>0&&Number.isFinite(w.hp)&&w.hp>0.5;});var p=policy(o),ready=0;
        var items=all.map(function(w,i){if(!w||w.phase===0)return null;var age=fed.has(w)?Math.max(0,(now-fed.get(w))/1000):0,wait=Math.max(0,o.feedSeconds-age,o.wrinklerMode==='timed'?o.wrinklerSeconds-age:0),reason='Ready to pop',eligible=false;
            if(!Number.isFinite(w.hp)||w.hp<=0.5)reason='Payout requested; waiting for game';
            else if(w.type===1&&o.protectShiny)reason='Shiny protected';
            else if(w.phase!==2)reason='Approaching; not attached yet';
            else if(num(w.sucked)<=0)reason='Attached; no stored cookies yet';
            else if(!o.wrinklers)reason='Automatic popping is off';
            else if(G.promptOn||G.OnAscend||G.AscendTimer>0)reason='Game is paused or showing a prompt';
            else if(p.hold)reason='Waiting for achievement rules';
            else if(o.wrinklerMode==='keep'&&alive.length<=o.keep)reason='Keeping '+o.keep+'; '+alive.length+' active';
            else if(wait>0)reason='Feeding wait: '+Math.ceil(wait)+' sec';
            else if(num(w.sucked)<o.storedMinimum)reason='Below stored-cookie minimum';
            else if(o.seasonFarm&&['halloween','easter'].includes(G.season)&&w.sucked<1)reason='Waiting for seasonal payout minimum';
            else {eligible=true;ready++;}
            return {slot:i+1,type:w.type===1?'Shiny':'Normal',phase:w.phase,stored:num(w.sucked),feedingSeconds:Math.floor(age),waitSeconds:Math.ceil(wait),reason:reason,eligible:eligible};}).filter(Boolean);
        return {active:alive.length,ready:ready,requested:counters.wrinklers,items:items,summary:!o.wrinklers?'Automatic popping is off':alive.length===0?'No active wrinklers in the game':o.wrinklerMode==='keep'&&alive.length<=o.keep?'Keeping all '+alive.length+' active wrinklers. Lower the keep count or choose a different rule.':ready?'Ready to pop '+ready+'; at most one per second':'Waiting for attachment, feeding, or your selected limits'};
    }
    function wrinklers(o,now){if(!o.wrinklers||!Array.isArray(G.wrinklers)||G.wrinklers.length>32)return false;observeWrinklers(now);var view=wrinklerView(o,now),item=view.items.find(function(w){return w.eligible;});return item?popWrinkler(G.wrinklers[item.slot-1]):false;}
    function shimmers(command,o,p,steady){if(G.promptOn||!Array.isArray(G.shimmers)||G.shimmers.length>2048)return;
        var start=performance.now();for(var i=0;i<G.shimmers.length&&performance.now()-start<1;i++){var s=G.shimmers[i],kind=s&&s.type==='reindeer'?'reindeer':s&&s.type==='golden'?(s.force==='cookie storm drop'?'storm':s.wrath?'wrath':'golden'):'';
            // The native forced storm reward is independent of its seasonal picture
            // and wrath flag. Ordinary wrath cookies still require their own opt-in.
            var allow=kind==='reindeer'?o.reindeer&&p.deer:kind==='wrath'?o.wrath&&p.golden:kind==='golden'||kind==='storm'?command.collectGolden&&p.golden:false;
            if(allow&&s.life>0&&typeof s.pop==='function'&&!attempts.has(s)){attempts.add(s);s.pop();counters[kind]++;return;}}
    }
    function stamp(parts){return parts.map(function(v){return text(v,240);}).join('|');}
    function makeQuote(key,label,cost,fingerprint,run,reason){var old=quotes.get(key);if(old&&old.fingerprint===fingerprint&&old.cost===cost&&performance.now()-old.created<=30000){old.run=run;old.reason=reason;return old;}var q={key:key,id:String(++quoteSerial),label:text(label,220),cost:num(cost),fingerprint:fingerprint,run:run,reason:text(reason),created:performance.now()};quotes.set(key,q);return q;}
    function quoteView(o,b){var seen=new Set(),result=[],r=reserve(o,b), spend=function(cost){return Number.isFinite(cost)&&cost>=0&&num(G.cookies)-cost>=r;};
        function add(key,label,cost,fp,run,reason){seen.add(key);var q=makeQuote(key,label,cost,fp,run,reason);result.push({key:q.key,id:q.id,label:q.label,cost:q.cost,reason:q.reason,available:!reason});}
        var seasons=G.seasons||{};Object.keys(seasons).slice(0,5).forEach(function(id){var u=seasons[id].triggerUpgrade;if(!u)return;var price=typeof u.getPrice==='function'?u.getPrice():NaN;
            add('season:'+id,'Switch to '+({christmas:'Christmas',halloween:'Halloween',valentines:"Valentine's Day",easter:'Easter',fools:'Business Day'}[id]||id)+' for 24 hours',price,stamp([G.resets,G.season,G.seasonUses,price]),function(){if(typeof u.buy==='function')u.buy();seasonLock=id;},!has('Season switcher')||!u.unlocked?'Season Switcher required':G.season===id?'Already active':seasonLock&&seasonLock!==id?'Stop the selected season first':!spend(price)?'Reserve protects this purchase':'');});
        // Exceptional zero-payout/shiny pops are individual approvals, never automatic rules.
        (G.wrinklers||[]).slice(0,32).forEach(function(w,i){if(w&&w.phase>0)add('wrinkler:'+i,'Pop '+(w.type===1?'SHINY ':'')+'wrinkler '+(i+1)+'; stored '+num(w.sucked)+'; may pay zero',0,stamp([G.resets,i,w.phase,w.type,w.sucked>0]),function(){popWrinkler(w);},'');});
        quotes.forEach(function(q,key){if(!seen.has(key))quotes.delete(key);});
        return result.slice(0,320);
    }
    function objectsStamp(){return (G.ObjectsById||[]).slice(0,32).map(function(b){return b.amount;}).join(',');}
    function stockCost(m,g){return num(G.cookiesPsRawHighest)*num(m.getGoodPrice(g))*(1+0.2*Math.pow(0.95,num(m.brokers)));}
    function execute(request,o,b,now){if(!request||request.id===handled)return false;handled=request.id;var q=quotes.get(request.key);
        if(!q||q.id!==request.quote||q.reason||now-q.created>30000){log('Action cancelled: preview expired or game state changed');return false;}
        // Rebuild the quote and compare the live preconditions before any spending or sacrifice.
        var previous=q;quoteView(o,b);q=quotes.get(request.key);if(!q||q.fingerprint!==previous.fingerprint||q.cost!==previous.cost||q.reason){log('Action cancelled: resources or requirements changed');return false;}
        if(o.completionist&&policy(o).target&&/^(ascend|sell:|dragon:|aura:|special:)/.test(request.key)){log('Stop Completionist before a conflicting destructive action');return false;}
        q.run();log('Approved action: '+q.label);return true;
    }
    // Native identities, not pictures, remain authoritative across all seasonal skins.
    function petView(o){
        var level=Number.isInteger(G.dragonLevel)?G.dragonLevel:0,levels=G.dragonLevels||[],need=[],cookieCost=0;
        if(o.petFocus&&level<levels.length-1){
            if(level<=4)cookieCost=Math.pow(2,level)*1000000;
            else if(level<levels.length-3)need=[{id:level-5,amount:100}];
            else need=(G.ObjectsById||[]).slice(0,32).map(function(b){return {id:b.id,amount:level===levels.length-3?50:200};});
        }
        var missing=need.filter(function(n){var b=G.ObjectsById&&G.ObjectsById[n.id];return b&&num(b.amount)<n.amount;});
        var drops=['Dragon scale','Dragon claw','Dragon fang','Dragon teddy bear'],remaining=drops.filter(function(n){var u=G.Upgrades&&G.Upgrades[n];return u&&!u.unlocked&&!u.bought;});
        var status=!o.petFocus?'Dragon training focus is off':!has('A crumbly egg')?'Requires How to bake your dragon and A crumbly egg':!levels.length?'Dragon rules unavailable':level>=levels.length-1?'Dragon fully trained':need.length&&!o.petSacrifices?'Waiting for permission to sacrifice buildings':missing.length?'Needs '+missing.map(function(n){return (G.ObjectsById[n.id].name)+': '+n.amount;}).join(', '):'Next training step ready if its cost fits your reserve';
        return {level:level,need:need,missing:missing,cookieCost:cookieCost,remaining:remaining,summary:status+'\nDragon level '+level+' / '+Math.max(0,levels.length-1)+'\nPetting drops left: '+(remaining.join(', ')||'None listed')+'\nPetting requires the open dragon panel; chance and time windows stay native.\nSanta: '+num(G.santaLevel)+' / '+Math.max(0,(G.santaLevels||[]).length-1)+(G.season==='christmas'?' (Christmas active)':' (waiting for Christmas; no automatic season purchase)')};
    }
    function pets(o,b){
        if(G.promptOn||G.OnAscend||G.AscendTimer>0||policy(o).target||policy(o).hold)return false;
        var view=petView(o),retained=reserve(o,b);
        function buyNamed(n){var u=G.Upgrades&&G.Upgrades[n];if(!u||u.bought||!u.unlocked||u.pool==='prestige'||typeof u.getPrice!=='function'||typeof u.buy!=='function'||u.choicesFunction||u.priceLumps>0)return false;var price=u.getPrice();if(!Number.isFinite(price)||price<0||price>num(G.cookies)-retained)return false;var before=u.bought;u.buy();return u.bought>before;}
        if(o.petFocus){
            if(!has('A crumbly egg')&&has('How to bake your dragon')&&buyNamed('A crumbly egg')){log('Bought the dragon egg within reserve');return true;}
            var level=G.dragonLevel,entry=(G.dragonLevels||[])[level];
            if(has('A crumbly egg')&&entry&&level<G.dragonLevels.length-1&&typeof entry.cost==='function'&&typeof G.UpgradeDragon==='function'&&!view.missing.length&&(view.need.length?o.petSacrifices:view.cookieCost<=num(G.cookies)-retained)&&entry.cost()){
                G.UpgradeDragon();log('Requested native dragon training step '+level);return true;
            }
        }
        if(o.santaFocus&&G.season==='christmas'){
            if(!has('A festive hat')&&buyNamed('A festive hat')){log('Bought the festive hat within reserve');return true;}
            var cost=Math.pow(num(G.santaLevel)+1,num(G.santaLevel)+1);
            if(has('A festive hat')&&Array.isArray(G.santaLevels)&&G.santaLevel<G.santaLevels.length-1&&Number.isFinite(cost)&&cost<=num(G.cookies)-retained&&typeof G.UpgradeSanta==='function'){G.UpgradeSanta();log('Requested native Santa upgrade');return true;}
        }
        if(o.dragonPet&&has('Pet the dragon')&&G.dragonLevel>=4&&G.specialTab==='dragon'&&typeof G.ClickSpecialPic==='function'&&view.remaining.length){G.ClickSpecialPic();return true;}
        return false;
    }
    var ascendPhase='watching',ascendError='',cycleOwned=false,saveSerial=0,lastFresh=-Infinity,lastAscendAction=-Infinity,liveCommand=null,planAt=-Infinity,chipPlan=null;
    function prestigeGain(){
        if(typeof G.HowMuchPrestige!=='function'||!Number.isFinite(G.cookiesReset)||!Number.isFinite(G.cookiesEarned)||!Number.isSafeInteger(G.prestige))return 0;
        var value=Math.floor(G.HowMuchPrestige(G.cookiesReset+G.cookiesEarned))-G.prestige;
        return Number.isSafeInteger(value)&&value>0?value:0;
    }
    function heavenlyPlan(budget){
        if(!Number.isSafeInteger(budget)||budget<0)return {items:[],spend:0,reason:'Chip balance needs manual review'};
        var all=G.PrestigeUpgrades;if(!Array.isArray(all)||all.length>256)return {items:[],spend:0,reason:'Heavenly catalog unavailable'};
        var entries=all.filter(function(u){return u&&u.pool==='prestige'&&!u.bought&&u.vanilla!==0&&!u.clickFunction&&!u.choicesFunction&&!u.activateFun