        if(id==='christmas') return ['Christmas tree biscuits','Snowflake biscuits','Snowman biscuits','Holly biscuits','Candy cane biscuits','Bell biscuits','Present biscuits'].concat(G.santaDrops || [], ['A festive hat',"Santa's dominion"]);
