y: [0, 1000000], stockSell: [0, 1000000], stockCap: [0, 10000], productionReserve: [0, 86400], maintenanceHours: [0, 24], backupCount: [0, 10], gardenX:[0,5], gardenY:[0,5] };
        if (Object.keys(ranges).some(function (k) { return !Number.isFinite(o[k]) || o[k] < ranges[k][0] || o[k] > ranges[k][1]; })) return false;
        if (!['keep', 'timed', 'threshold'].includes(o.wrinklerMode) || !['ripe', 'mature'].includes(o.lumpRule)) return false;
        if (!['production', 'cheapest'].includes(o.shopMode)) return false;
        if ([o.storedMinimum, o.stockBudget].some(function (n) { return !Number.isFinite(n) || n < 0 || n > 1e300; })) return false;
        if (typeof o.pin !== 'string' || o.pin.length > 100 || !Array.isArray(o.excluded) || o.excluded.length > 128 || o.excluded.some(function (n) { return typeof n !== 'string' || n.length > 100; })) return false;
        if (!Array.isArray(o.categories) || o.categories.length > 8 || o.categories.some(function (n) { return !['Buildings', 'Production', 'Clicks', 'Seasonal', 'Wrinklers', 'Minigames', 'Challenges', 'Other'].includes(n); })) return false;
