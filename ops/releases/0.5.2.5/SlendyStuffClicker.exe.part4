                                        clicks++; recent[(recentHead + recentSize) % maxRate] = timestamp; recentSize++;
                                    }
                                    if(protection.target&&Game.Achievements&&Game.Achievements[protection.target]&&Game.Achievements[protection.target].won){refreshProtection();if(protection.hold||!protection.main){credit=0;break;}}
                                }
                            } finally {
                                if (suppressEffects) {
                                    if (prefs) { prefs.particles = particles; prefs.numbers = numbers; }
                                    if (typeof sound === 'function' && Game.playCookieClickSound === silence) Game.playCookieClickSound = sound;
                                }
                            }
                        }
                        if ((command.limit > 0 && clicks >= command.limit) || clicks >= 1000000000) state = 'complete';
                        if (state === 'clicking' && command.autoBuy.enabled && elapsed > 0 && elapsed <= 100 && steady-lastBuy>=250 && performance.now() - steady < 8) {
                            lastBuy=steady;var bought=automation.shop(command.autoBuy,gameplay,protection.upgrades,true);if(bought.purchased)purchases++;
                        }
                    }
                    // One advanced decision per second, and bounded local progress scans. No timer catch-up.
                    if(!advancedProcessed)automation.tick(command,gameplay,steady,command.running&&!faulted&&elapsed>0&&elapsed<=100&&performance.now()-steady<8);
                    sendTelemetry(steady);
                    if (steady - lastReport >= 1000 || (state === 'complete' && previousState !== 'complete')) { lastReport = steady; report(); }
                } catch (error) { state = 'error'; credit = 0; faulted = true; report(); }
            };
            events.onerror = function () { state = 'disconnected'; faulted=true; credit=0; };
        }
    });
})();
