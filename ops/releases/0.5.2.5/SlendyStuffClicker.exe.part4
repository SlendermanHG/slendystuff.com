        var ctx=G.LeftBackground;if(!ctx||typeof ctx.fillText!=='function')return;var o=liveCommand.gameplay,now=performance.now(),items=wrinklerView(o,now).items;
        ctx.save();try{ctx.font='bold 12px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.globalAlpha=0.95;
            items.forEach(function(item){var w=G.wrinklers[item.slot-1];if(!w||!Number.isFinite(w.x)||!Number.isFinite(w.y)||w.hp<=0.5)return;var label=item.type==='Shiny'?'Protected':item.phase!==2?'Feed '+item.waitSeconds+'s':item.waitSeconds>0?item.waitSeconds+'s':item.eligible?'Ready':item.reason.startsWith('Keeping')?'Kept':item.stored<o.storedMinimum?'Minimum':!item.stored?'Not feeding':'Waiting';
                var width=Math.min(130,ctx.measureText(label).width+12),x=w.x,y=w.y+30;ctx.fillStyle='#111a32';ctx.fillRect(x-width/2,y-10,width,20);ctx.fillStyle='#ff6eb5';ctx.fillText(label,x,y);
            });
        }finally{ctx.restore();}
    }

    function tick(command,o,now,fresh){
        if(command.releaseSeason&&command.releaseSeason!==released){released=command.releaseSeason;seasonLock='';log('Selected season released; no automatic switch was purchased');}
        if(session!==command.session){session=command.session;saveSerial++;ascendError='';cycleOwned=false;ascendPhase='watching';tradeSpent=0;lastAction=-Infinity;handled='';fed.clear();}
        if(!supported)return;
