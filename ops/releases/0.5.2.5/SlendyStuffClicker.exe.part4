                    Array.isArray(options.buildings) && options.buildings.length <= 32 &&
                    options.buildings.every(function (id, i, ids) { return Number.isInteger(id) && id >= 0 && id <= 1023 && ids.indexOf(id) === i; }) &&
                    Array.isArray(options.upgrades) && options.upgrades.length <= 3 &&
