                lumps:{available:num(G.lumps),status:!can?'Locked':Date.now()-G.lumpT>=G.lumpRipeAge?'Ripe':Date.now()-G.lumpT>=G.lumpMatureAge?'Mature (harvest can fail)':'Growing',seconds:can?Math.max(0,Math.ceil((G.lumpT+G.lumpRipeAge-Date.now())/1000)):0},
                tools:{garden:garden?'Seeds '+garden.plantsUnlockedN+'/'+garden.plantsN+'; harvests '+garden.harvests+(garden.freeze?'; frozen':''):'Unlock Farm level 1',grimoire:gr?'Mana '+Math.floor(gr.magic)+'/'+gr.magicM+'; spells '+gr.spellsCastTotal:'Unlock Wizard tower level 1',pantheon:pant?'Worship swaps '+pant.swaps:'Unlock Temple level 1',dragon:'Level '+num(G.dragonLevel)+'; petting needs the open dragon panel',stock:market?'Profit '+text(market.profit)+'; run budget spent '+tradeSpent:'Unlock Bank level 1',ascension:'Potential prestige '+num(G.ascendMeterLevel)+'; prepare: save, review wrinklers, rare harvests and Chocolate egg; select the native challenge mode after ascension',auraAdvice:'Production: Radiant Appetite / Breath of Milk; clicks: Dragonflight; wrinklers: Dragon Guts. Review your build before sacrificing.'},
                stocks:market?(market.goodsById||[]).slice(0,32).map(function(g){return {name:text(g.name,60),price:num(g.val),stock:num(g.stock),cost:stockCost(market,g),advice:g.val<=o.stockBuy?'Below buy target':g.val>=o.stockSell?'Above sell target':'Watch'};}):[],seedGoals:garden?(garden.plantsById||[]).slice(0,36).filter(function(p){return !p.unlocked;}).map(function(p){return text(p.name,60);}):[],steam:'Game-earned flags only; Steam delivery is not independently confirmed'};
        }
    }
    return {draw:drawWrinklerCountdowns,petView:petView,heavenlyPlan:heavenlyPlan,ascensionView:ascensionView,validate:valid,prepare:prepare,policy:policy,tick:tick,shimmers:shimmers,shop:shop,inspect:function(){return supported?Object.assign({schema:1,version:text(G.version,20),supported:true},snapshot):{schema:1,version:text(G.version,20),supported:false,history:['Advanced actions stopped: installed game version needs adapter review']};},seasonView:seasonView,natural:natural,easter:easter,rule:rule,reserve:reserve,execute:execute,quotes:quoteView,counters:counters};
