                    var gameplay=command.gameplay;automation.prepare(gameplay,steady);var protection=automation.policy(gameplay),advancedProcessed=false;
                    if (!command.running) { credit = 0; state = command.limit > 0 && clicks >= command.limit ? 'complete' : 'stopped'; }
                    else if ((command.limit > 0 && clicks >= command.limit) || clicks >= 1000000000) { credit = 0; state = 'complete'; }
