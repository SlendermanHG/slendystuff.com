            if(gainNow<liveCommand.gameplay.ascendMinimum||!check.items.length||activeBonus()||liveCommand.gameplay.ascendPayouts&&(G.wrinklers||[]).some(function(w){return w&&w.phase>0&&num(w.sucked)>0;}))return;
            cycleOwned=true;ascendPhase='ascending';G.Ascend(1);log('Requested native ascension after verified save');
        }).catch(function(){if(serial===saveSerial){ascendError='Save verification failed; ascension stays stopped';log(ascendError);}}).finally(function(){if(serial===saveSerial&&ascendPhase==='saving')ascendPhase='watching';});return true;
    }
