                Game.WriteSave();var expected=localStorageGet(Game.SaveTo);
                if(typeof expected!=='string'||expected.length<10||expected.length>4194304)throw new Error('Save size');
                var deadline=performance.now()+18000;while(Game.isSaving){if(performance.now()>deadline)throw new Error('Save deadline');await new Promise(function(resolve){setTimeout(resolve,100);});}
                var actual=await new Promise(function(resolve,reject){var timeout=setTimeout(function(){reject(new Error('Read-back deadline'));},3000);send('load',function(data){clearTimeout(timeout);resolve(data);});});
                if(actual!==expected)throw new Error('Read-back mismatch');
            }
            if(typeof Game.registerHook==='function')Game.registerHook('draw',function(){automation.draw();});
            async function saveAndQuit(id) {
