ction&&!u.canBuyFunc&&typeof u.buy==='function'&&typeof u.getPrice==='function';});
        var prices=new Map();entries=entries.filter(function(u){var price=u.getPrice();if(!Number.isSafeInteger(price)||price<0||price>budget)return false;if(u.showIf&&!u.showIf())return false;prices.set(u,price);return true;});
