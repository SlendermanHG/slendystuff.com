                fetch(base + '/state?token=' + token + '&session=' + encodeURIComponent(session) + '&clicks=' + clicks + '&purchases=' + purchases + '&state=' + state + '&boot=' + boot + '&restartSupported=' + (supportsRestart ? '1' : '0'),
